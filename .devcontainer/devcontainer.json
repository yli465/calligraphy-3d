{
  "name": "Calligraphy 3D",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Calligraphy 3D",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "python3 -m http.server 8080 --bind 0.0.0.0",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}